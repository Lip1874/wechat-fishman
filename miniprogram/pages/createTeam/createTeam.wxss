.page {
  padding: 24rpx 20rpx 60rpx;
  min-height: 100vh;
  background: #f6f7f9;
  box-sizing: border-box;
}

/* 头部 */
.header-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #0aa55e, #008844);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 136, 68, 0.25);
}
.header-icon {
  width: 88rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
}
.header-title {
  font-size: 36rpx;
  font-weight: 700;
}
.header-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

/* 表单 */
.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.form-item {
  display: flex;
  flex-direction: column;
  padding: 26rpx 0;
}
.label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 18rpx;
}
.label-icon {
  margin-right: 12rpx;
  font-size: 30rpx;
}
.input {
  display: block;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 32rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
}
.placeholder {
  color: #b0b4bb;
}
.btn-create {
  margin: 20rpx 0 28rpx;
  background: linear-gradient(135deg, #0aa55e, #008844);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
}
.btn-create::after {
  border: none;
}

/* 创建成功邀请卡片 */
.invite-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  text-align: center;
}
.invite-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}
.invite-sub {
  font-size: 24rpx;
  color: #999;
  margin: 12rpx 0 28rpx;
}
.btn-invite {
  background: linear-gradient(135deg, #0aa55e, #008844);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
}
.btn-invite::after {
  border: none;
}

.tip {
  font-size: 24rpx;
  color: #b0b4bb;
  text-align: center;
  margin: 8rpx 0 24rpx;
}
.btn-hover {
  opacity: 0.85;
}
