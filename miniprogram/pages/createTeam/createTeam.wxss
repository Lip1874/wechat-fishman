.page {
  position: relative;
  padding: 24rpx 20rpx 60rpx;
  min-height: 100vh;
  background: #f5f7fa;
  box-sizing: border-box;
}

/* 顶部浅蓝背景装饰 */
.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 320rpx;
  background: linear-gradient(180deg, #e6f4ff 0%, #f5f7fa 100%);
  z-index: 0;
}

/* 头部 */
.header-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}
.header-icon {
  width: 88rpx;
  height: 88rpx;
  background: #e6f4ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
}
.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
}
.header-sub {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
}

/* 表单 */
.form-card {
  position: relative;
  z-index: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}
.form-item {
  display: flex;
  flex-direction: column;
  padding: 26rpx 0;
}
.label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 18rpx;
}
.label-icon {
  margin-right: 12rpx;
  font-size: 30rpx;
}
.input {
  display: block;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 32rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
}
.placeholder {
  color: #b0b4bb;
}
.btn-create {
  margin: 20rpx 0 28rpx;
  background: linear-gradient(90deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
}
.btn-create::after {
  border: none;
}

/* 创建成功邀请卡片 */
.invite-card {
  position: relative;
  z-index: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  text-align: center;
}
.invite-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}
.invite-sub {
  font-size: 24rpx;
  color: #999;
  margin: 12rpx 0 28rpx;
}
.btn-invite {
  background: linear-gradient(90deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
}
.btn-invite::after {
  border: none;
}

.tip {
  font-size: 24rpx;
  color: #b0b4bb;
  text-align: center;
  margin: 8rpx 0 24rpx;
}
.btn-hover {
  opacity: 0.85;
}
