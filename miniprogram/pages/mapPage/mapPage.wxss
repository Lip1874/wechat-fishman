page{
  margin: 0;
  padding: 0;
  background: #eef0f2;
}
.page{
  position: relative;
  width: 100%;
  height: 100vh;
}
.map{
  width: 100%;
  height: 100%;
  display: block;
}

/* 底部信息条 */
.footer{
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 10;
}
.footer-title{
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}
.footer-sub{
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}
.footer-btn{
  flex-shrink: 0;
  margin: 0;
  background: linear-gradient(135deg, #0aa55e, #008844);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 36rpx;
}
.footer-btn::after{
  border: none;
}
.footer-btn-hover{
  opacity: 0.85;
  transform: scale(0.97);
}
