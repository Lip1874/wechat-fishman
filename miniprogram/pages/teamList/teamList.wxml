<view class="page">
  <view class="header-bg"></view>
  <!-- 头部 -->
  <view class="header-card">
    <view class="header-icon">👥</view>
    <view class="header-info">
      <view class="header-title">我的团队</view>
      <view class="header-sub">创建或加入团队，共同维护钓点库</view>
    </view>
    <view class="header-btn" bindtap="goCreate" hover-class="btn-hover">+ 创建</view>
  </view>

  <!-- 永不空军同步提示 -->
  <view class="sync-tip">
    <text class="sync-tip-icon">✅</text>
    <text class="sync-tip-text">已自动同步：团队钓点会实时同步到首页「永不空军」分组，与私有钓点区分展示</text>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{teams.length === 0}}" class="empty">
    <view class="empty-icon">👥</view>
    <view class="empty-text">创建/加入钓友团队</view>
    <view class="empty-sub">共享钓点 · 同步渔获 · 组队出钓</view>
    <view class="empty-btn" bindtap="goCreate" hover-class="btn-hover">立即创建团队</view>
  </view>

  <!-- 团队列表：点击进入团队详情页 -->
  <view
    wx:for="{{teams}}"
    wx:key="_id"
    class="team-card"
    bindtap="goDetail"
    data-id="{{item._id}}"
    hover-class="btn-hover"
  >
    <view class="team-icon">🎣</view>
    <view class="team-info">
      <view class="team-name">{{item.teamName}}</view>
      <view class="team-sub">{{item.memberCount}} 人 · {{item.isCreator ? '我创建的' : '我加入的'}}</view>
    </view>
    <view class="team-arrow">›</view>
  </view>

  <view wx:if="{{loading && teams.length}}" class="loading-text">加载中...</view>
</view>
