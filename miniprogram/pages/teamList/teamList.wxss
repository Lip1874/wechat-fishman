.page {
  padding: 24rpx 20rpx 60rpx;
  min-height: 100vh;
  background: #f6f7f9;
  box-sizing: border-box;
}

/* 头部 */
.header-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #0aa55e, #008844);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 136, 68, 0.25);
}
.header-icon {
  width: 88rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
}
.header-info {
  flex: 1;
}
.header-title {
  font-size: 36rpx;
  font-weight: 700;
}
.header-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}
.header-btn {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  color: #fff;
  padding: 12rpx 26rpx;
  border-radius: 32rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}
.empty-icon {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 30rpx;
  color: #666;
  font-weight: 600;
}
.empty-sub {
  font-size: 24rpx;
  color: #b0b4bb;
  margin-top: 8rpx;
  text-align: center;
}
.empty-btn {
  margin-top: 40rpx;
  background: linear-gradient(135deg, #0aa55e, #008844);
  color: #fff;
  font-size: 28rpx;
  padding: 18rpx 48rpx;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 136, 68, 0.3);
}

/* 团队卡片 */
.team-card {
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}
.team-head {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
}
.team-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: rgba(0, 136, 68, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 22rpx;
}
.team-info {
  flex: 1;
  min-width: 0;
}
.team-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}
.team-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.team-arrow {
  font-size: 28rpx;
  color: #b0b4bb;
  margin-left: 16rpx;
}

/* 展开区域 */
.team-body {
  border-top: 1rpx solid #f2f3f5;
  padding: 20rpx 28rpx 28rpx;
}
.member-list {
  margin-bottom: 20rpx;
}
.member-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f6f8;
}
.member-row:last-child {
  border-bottom: none;
}
.member-avatar {
  font-size: 30rpx;
  margin-right: 14rpx;
}
.member-short {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}
.member-tag {
  font-size: 20rpx;
  color: #008844;
  background: rgba(0, 136, 68, 0.08);
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
  margin-left: 10rpx;
}
.self-tag {
  color: #1890ff;
  background: rgba(24, 144, 255, 0.1);
}
.member-del {
  font-size: 22rpx;
  color: #e64340;
  border: 2rpx solid rgba(230, 67, 64, 0.4);
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  margin-left: 12rpx;
}
.team-actions {
  display: flex;
  gap: 16rpx;
}
.btn-invite {
  flex: 1;
  background: linear-gradient(135deg, #0aa55e, #008844);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  height: 76rpx;
  line-height: 76rpx;
}
.btn-invite::after {
  border: none;
}
.btn-danger {
  flex: 1;
  background: #fff;
  color: #e64340;
  border: 2rpx solid rgba(230, 67, 64, 0.4);
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.btn-hover {
  opacity: 0.85;
}
