.page {
  position: relative;
  padding: 24rpx 20rpx 60rpx;
  min-height: 100vh;
  background: #f5f7fa;
  box-sizing: border-box;
}

/* 顶部浅蓝背景装饰 */
.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 320rpx;
  background: linear-gradient(180deg, #e6f4ff 0%, #f5f7fa 100%);
  z-index: 0;
}

/* 头部 */
.header-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}
.header-icon {
  width: 88rpx;
  height: 88rpx;
  background: #e6f4ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
}
.header-info {
  flex: 1;
}
.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
}
.header-sub {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
}
.header-btn {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  background: linear-gradient(90deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
  padding: 12rpx 26rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 14rpx rgba(22, 119, 255, 0.3);
}

/* 永不空军同步提示 */
.sync-tip {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  background: #fff7e6;
  border: 2rpx solid #ffe7ba;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}
.sync-tip-icon {
  font-size: 26rpx;
  margin-right: 10rpx;
}
.sync-tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #ad6800;
  line-height: 1.5;
}

/* 空状态 */
.empty {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 80rpx;
}
.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 32rpx;
  color: #444;
  font-weight: 700;
}
.empty-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  text-align: center;
}
.empty-btn {
  margin-top: 44rpx;
  background: linear-gradient(90deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 64rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.35);
}

/* 团队卡片 */
.team-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  padding: 26rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}
.team-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: #e6f4ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.team-info {
  flex: 1;
  min-width: 0;
}
.team-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}
.team-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.team-arrow {
  font-size: 36rpx;
  font-weight: 600;
  color: #c0c4cc;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.loading-text {
  position: relative;
  z-index: 1;
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 20rpx 0;
}

.btn-hover {
  opacity: 0.85;
}
