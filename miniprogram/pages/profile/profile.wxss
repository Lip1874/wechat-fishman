page {
  background: #f5f7fa;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 2rpx solid #f2f4f6;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 30rpx;
  color: #333;
  width: 160rpx;
  flex-shrink: 0;
}

.avatar-btn {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-placeholder {
  background: #e6f4ff;
  color: #1890ff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx;
  text-align: center;
  box-sizing: border-box;
}

.input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: #333;
}

.tip {
  margin-top: 20rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.save-btn {
  margin-top: 60rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: #1890ff;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.25);
}

.save-btn.saving {
  opacity: 0.7;
}
