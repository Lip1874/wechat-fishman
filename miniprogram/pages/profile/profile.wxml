<view class="page">
  <view class="card">
    <view class="form-item">
      <text class="label">头像</text>
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image class="avatar" src="{{avatarDisplayUrl || profile.avatarUrl || '/images/avatar.png'}}" mode="aspectFill" wx:if="{{avatarDisplayUrl || profile.avatarUrl}}"></image>
        <view class="avatar avatar-placeholder" wx:else>点击设置头像</view>
      </button>
    </view>

    <view class="form-item">
      <text class="label">昵称</text>
      <input class="input" type="nickname" value="{{profile.nickName}}" placeholder="请输入昵称" bind:blur="onNickNameBlur" />
    </view>

    <view class="form-item">
      <text class="label">备注名称</text>
      <input class="input" value="{{profile.remark}}" placeholder="例如：和园" bind:blur="onRemarkBlur" />
    </view>
  </view>

  <view class="tip">头像和昵称会保存在云端，换设备登录后可同步。</view>

  <button class="save-btn {{saving ? 'saving' : ''}}" bindtap="saveProfile" disabled="{{saving}}">保存</button>
</view>
