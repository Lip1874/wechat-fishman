.page {
  position: relative;
  padding: 24rpx 20rpx 180rpx;
  min-height: 100vh;
  background: #f5f7fa;
  box-sizing: border-box;
}

/* 顶部浅蓝背景装饰 */
.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 320rpx;
  background: linear-gradient(180deg, #e6f4ff 0%, #f5f7fa 100%);
  z-index: 0;
}

/* 头部 */
.header-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}
.header-icon {
  width: 88rpx;
  height: 88rpx;
  background: #e6f4ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
}
.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
}
.header-sub {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
}

/* 表单卡片 */
.form-card {
  position: relative;
  z-index: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}
.form-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.form-item:last-child {
  border-bottom: none;
}
.label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 18rpx;
}
.label-icon {
  margin-right: 12rpx;
  font-size: 30rpx;
}
.required {
  color: #e64340;
  margin-left: 8rpx;
}
.count {
  margin-left: auto;
  font-size: 24rpx;
  color: #b0b4bb;
  font-weight: 400;
}

/* 输入框 */
.form-item {
  display: flex;
  flex-direction: column;
}
.input {
  display: block;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 32rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
}
.textarea {
  display: block;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  width: 100%;
  box-sizing: border-box;
  height: 260rpx;
  font-size: 32rpx;
}
.placeholder {
  color: #b0b4bb;
}

/* 下拉选择 */
.picker-full {
  display: block;
  width: 100%;
}
.select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  min-height: 88rpx;
  box-sizing: border-box;
}
.select-active {
  background: rgba(22, 119, 255, 0.06);
  border: 2rpx solid rgba(22, 119, 255, 0.3);
  box-sizing: border-box;
}
.select-value {
  font-size: 32rpx;
  color: #333;
}
.select-value.placeholder {
  color: #b0b4bb;
}
.select-arrow {
  flex-shrink: 0;
  color: #b0b4bb;
  font-size: 44rpx;
  line-height: 1;
  margin-left: 16rpx;
}
/* 鱼种 chips */
.fish-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.fish-chip {
  background: rgba(22, 119, 255, 0.1);
  color: #1677ff;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}
.fish-chip-del {
  margin-left: 8rpx;
  font-size: 28rpx;
  color: #666;
}

/* 鱼种多选面板 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}
.panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s ease;
}
.panel-show {
  transform: translateY(0);
}
.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}
.panel-close {
  font-size: 44rpx;
  color: #999;
  padding: 0 8rpx;
}
.panel-body {
  max-height: 520rpx;
}
.fish-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid #f2f3f5;
  font-size: 30rpx;
  color: #333;
}
.fish-option-active {
  color: #1677ff;
  font-weight: 600;
}
.check {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #c9cdd4;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 26rpx;
  color: #fff;
  box-sizing: border-box;
}
.fish-option-active .check {
  background: #1677ff;
  border-color: #1677ff;
}
.panel-footer {
  margin-top: 24rpx;
}
.panel-btn {
  background: linear-gradient(90deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
}
.panel-btn::after {
  border: none;
}

/* 收费类型标签 */
.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag {
  padding: 14rpx 30rpx;
  border-radius: 40rpx;
  background: #f5f6f8;
  color: #666;
  font-size: 26rpx;
  border: 2rpx solid transparent;
}
.tag-active {
  background: rgba(22, 119, 255, 0.08);
  color: #1677ff;
  border-color: #1677ff;
  font-weight: 600;
}

/* 地图选点 */
.map-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 24rpx;
}
.map-picker-title {
  font-size: 28rpx;
  color: #666;
}
/* 已选坐标 -> 地图预览 */
.map-preview-wrap {
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid rgba(22, 119, 255, 0.3);
  box-sizing: border-box;
}
.map-preview {
  width: 100%;
  height: 300rpx;
  display: block;
}
.map-preview-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx;
  background: rgba(22, 119, 255, 0.06);
}
.map-preview-btn {
  font-size: 26rpx;
  color: #fff;
  background: #1677ff;
  border-radius: 30rpx;
  padding: 8rpx 28rpx;
}
.map-picker-coord {
  font-size: 22rpx;
  color: #1677ff;
  margin-top: 8rpx;
}

/* 自定义地图选点弹层 */
.map-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}
.map-picker-panel {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  flex-direction: column;
}
.map-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.map-picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.map-picker-close {
  font-size: 44rpx;
  color: #999;
  padding: 0 8rpx;
}
.map-search {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f2f3f5;
}
.map-search-input {
  flex: 1;
  background: #f5f6f8;
  border-radius: 40rpx;
  height: 72rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}
.map-search-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  background: #1677ff;
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 30rpx;
  border-radius: 40rpx;
}
.map-search-list {
  max-height: 360rpx;
  background: #fff;
  border-bottom: 1rpx solid #f2f3f5;
  box-sizing: border-box;
}
.map-search-item {
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.map-search-item:active {
  background: #f5f6f8;
}
.map-search-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}
.map-search-addr {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.map-full {
  flex: 1;
  width: 100%;
}
.map-picker-footer {
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
}
.map-picker-confirm {
  background: linear-gradient(90deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
}
.map-picker-confirm::after {
  border: none;
}

/* 图片 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.img-item {
  position: relative;
  width: 196rpx;
  height: 196rpx;
}
.preview-img {
  width: 196rpx;
  height: 196rpx;
  border-radius: 16rpx;
}
.img-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 28rpx;
}
.add-img {
  width: 196rpx;
  height: 196rpx;
  border: 2rpx dashed #c9cdd4;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #b0b4bb;
  background: #fafbfc;
}
.add-plus {
  font-size: 56rpx;
  line-height: 1;
}
.add-text {
  font-size: 24rpx;
  margin-top: 10rpx;
}

/* 提示与提交 */
.tip {
  font-size: 24rpx;
  color: #b0b4bb;
  text-align: center;
  margin: 8rpx 0 24rpx;
}
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.btn-submit {
  background: linear-gradient(90deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
}
.btn-submit::after {
  border: none;
}
.btn-hover {
  opacity: 0.85;
}

/* ---- 天气快照（新增自动记录 / 编辑展示已存记录） ---- */
.weather-snap {
  background: #f0f7ff;
  border: 2rpx solid rgba(22, 119, 255, 0.12);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.weather-snap-main {
  display: flex;
  align-items: center;
}
.weather-snap-emoji {
  flex-shrink: 0;
  font-size: 56rpx;
  margin-right: 20rpx;
}
.weather-snap-info {
  flex: 1;
  min-width: 0;
}
.weather-snap-temp {
  font-size: 36rpx;
  font-weight: 800;
  color: #222;
  line-height: 1.2;
}
.weather-snap-text {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.weather-snap-time {
  font-size: 22rpx;
  color: #8a8f99;
  margin-top: 12rpx;
}
.weather-snap-loading {
  font-size: 22rpx;
  color: #1677ff;
  margin-top: 12rpx;
}
