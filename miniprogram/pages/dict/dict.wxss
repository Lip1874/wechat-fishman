page {
  background: #f5f5f5;
}

.page {
  min-height: 100vh;
  padding-bottom: 180rpx;
}

/* 头部 */
.header {
  position: relative;
  padding: 48rpx 40rpx 52rpx;
  background: linear-gradient(135deg, #19c56f 0%, #0aa55e 42%, #00723a 100%);
  border-radius: 0 0 44rpx 44rpx;
  overflow: hidden;
}
.header-title {
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
}
.header-sub {
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  margin-top: 10rpx;
}

/* 列表（movable-list 拖拽排序） */
.list {
  margin: 28rpx 24rpx 0;
}
.movable-list {
  width: 100%;
}
.movable-item {
  margin-bottom: 18rpx;
}
.item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
}
.item-main {
  flex: 1;
  min-width: 0;
}
.item-label-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.item-label {
  font-size: 30rpx;
  color: #333;
  font-weight: 700;
}
.item-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #0aa55e;
  background: rgba(10, 165, 94, 0.1);
  border: 1rpx solid rgba(10, 165, 94, 0.35);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
.item-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}
.item-ops {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: 16rpx;
}
.op {
  min-width: 76rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  padding: 0 18rpx;
  box-sizing: border-box;
}
.op-edit {
  background: rgba(0, 136, 68, 0.1);
  color: #008844;
}
.op-del {
  background: rgba(230, 67, 64, 0.08);
  color: #e64340;
}
.op-hover {
  opacity: 0.75;
}
.drag-handle {
  flex-shrink: 0;
  color: #c8c8c8;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
  padding-left: 16rpx;
}

/* 空状态 */
.empty {
  margin: 40rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 72rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.05);
}
.empty-icon {
  font-size: 72rpx;
}
.empty-text {
  color: #666;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 20rpx;
}
.empty-sub {
  color: #999;
  font-size: 24rpx;
  margin-top: 12rpx;
}

/* 底部新增按钮 */
.add-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.06);
}
.add-btn {
  background: linear-gradient(135deg, #0aa55e, #008844);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 48rpx;
}
.add-btn-hover {
  opacity: 0.85;
}
