page {
  background: #f5f5f5;
}

.page {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* 表单卡片 */
.form-card {
  background: #fff;
  border-radius: 24rpx;
  margin: 28rpx 24rpx 0;
  padding: 10rpx 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.05);
}
.form-item {
  padding: 30rpx 0;
  border-bottom: 2rpx solid #f2f2f2;
}
.form-item:last-child {
  border-bottom: none;
}
.label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 18rpx;
}
.required {
  color: #e64340;
  margin-right: 6rpx;
}
.input {
  background: #f7f7f7;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}
.placeholder {
  color: #bbb;
}
.tip {
  padding: 26rpx 0 34rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.7;
}

/* 底部提交 */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.06);
}
.btn-submit {
  background: linear-gradient(135deg, #0aa55e, #008844);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 48rpx;
}
.btn-hover {
  opacity: 0.85;
}
