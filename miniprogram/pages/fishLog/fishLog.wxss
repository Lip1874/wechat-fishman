/* ============================================================
   电子鱼护 - 样式（按图像：浅蓝顶 + 月度卡 + 按位置 + 大蓝按钮 + 鱼种横滑 + 最近记录）
   ============================================================ */
page {
  background: #f5f7fa;
}

.page {
  min-height: 100vh;
  padding: 0 24rpx 64rpx;
  position: relative;
  box-sizing: border-box;
}

/* 顶部淡蓝背景装饰 */
.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 560rpx;
  background: linear-gradient(180deg, #e6f4ff 0%, #f5f7fa 100%);
  z-index: 0;
}

/* ---- 通用卡片 ---- */
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.3;
}
.card-sub {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-top: 8rpx;
  line-height: 1.4;
}
.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card-link {
  font-size: 24rpx;
  color: #1677ff;
  font-weight: 500;
}

/* ---- 1. 月度统计卡 ---- */
.month-card {
  position: relative;
  z-index: 1;
  margin: 24rpx 0 24rpx;
  padding: 32rpx 28rpx 36rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.04);
}
.month-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.month-arrow {
  width: 56rpx;
  height: 56rpx;
  background: #f5f7fa;
  color: #5b6573;
  font-size: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}
.month-arrow:active {
  background: #e6e9ef;
}
.month-info {
  flex: 1;
  text-align: center;
}
.month-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.3;
}
.month-sub {
  font-size: 22rpx;
  color: #5b6573;
  margin-top: 8rpx;
}

.count-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx dashed #ecf0f5;
}
.count-main {
  display: flex;
  align-items: baseline;
}
.count-num {
  font-size: 80rpx;
  font-weight: 800;
  color: #1677ff;
  line-height: 1;
  letter-spacing: -1rpx;
}
.count-unit {
  margin-left: 10rpx;
  font-size: 28rpx;
  color: #5b6573;
  font-weight: 600;
}
.count-stats {
  display: flex;
  text-align: right;
}
.count-stat {
  margin-left: 36rpx;
}
.count-stat-label {
  font-size: 22rpx;
  color: #8c8c8c;
  line-height: 1.3;
}
.count-stat-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
  margin-top: 4rpx;
}

/* 周柱图 */
.week-bars {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 0 4rpx;
}
.week-bar {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.bar-track {
  position: relative;
  width: 24rpx;
  height: 120rpx;
  background: #f1f4f8;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}
.bar-fill {
  width: 100%;
  background: linear-gradient(180deg, #4096ff, #1677ff);
  border-radius: 12rpx;
  transition: height 0.35s ease;
  min-height: 4rpx;
}
.bar-num {
  font-size: 22rpx;
  color: #1677ff;
  font-weight: 700;
  margin-top: 8rpx;
  line-height: 1;
}
.bar-label {
  font-size: 20rpx;
  color: #8c8c8c;
  margin-top: 6rpx;
  line-height: 1;
}

/* ---- 2. 本月按位置 ---- */
.location-card {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  padding: 28rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}
.location-empty {
  margin-top: 24rpx;
  padding: 56rpx 0;
  background: #f5f7fa;
  border-radius: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9aa3af;
  line-height: 1.5;
}
.location-list {
  margin-top: 16rpx;
}
.location-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f2f4f6;
}
.location-item:last-child {
  border-bottom: none;
}
.location-marker {
  margin-right: 18rpx;
  width: 20rpx;
  height: 20rpx;
  position: relative;
}
.location-dot {
  width: 16rpx;
  height: 16rpx;
  background: #1677ff;
  border-radius: 50%;
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  box-shadow: 0 0 0 6rpx rgba(22, 119, 255, 0.15);
}
.location-main {
  flex: 1;
  min-width: 0;
}
.location-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.location-meta {
  font-size: 22rpx;
  color: #8c8c8c;
  margin-top: 6rpx;
  line-height: 1.4;
}
.location-arrow {
  font-size: 36rpx;
  color: #c9cdd4;
  margin-left: 12rpx;
}

/* ---- 3. 大蓝色按钮 ---- */
.add-btn {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #4096ff 0%, #1677ff 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(22, 119, 255, 0.35);
}
.add-btn-icon {
  font-size: 38rpx;
  margin-right: 10rpx;
  font-weight: 400;
}
.add-btn-text {
  letter-spacing: 2rpx;
}
.add-btn-hover {
  opacity: 0.92;
  transform: scale(0.99);
}

/* ---- 4. 常见鱼快速处理 ---- */
.fish-card {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  padding: 28rpx 28rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}
.fish-scroll {
  margin: 0 -28rpx;
  margin-top: 24rpx;
  white-space: nowrap;
}
.fish-list {
  display: inline-flex;
  padding: 0 28rpx 8rpx;
}
.fish-item {
  display: inline-block;
  width: 140rpx;
  margin-right: 18rpx;
  text-align: center;
}
.fish-circle {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.fish-glyph {
  position: relative;
  width: 88rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fish-body {
  width: 70rpx;
  height: 28rpx;
  border: 4rpx solid;
  border-radius: 50%;
  box-sizing: border-box;
}
.fish-tail {
  position: absolute;
  right: 0;
  top: 50%;
  width: 0;
  height: 0;
  transform: translateY(-50%);
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-right: 16rpx solid;
  border-right-color: inherit;
}
.fish-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #1f2329;
  white-space: nowrap;
}

/* ---- 5. 最近记录 ---- */
.recent-card {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  padding: 28rpx 28rpx 16rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}
.recent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.recent-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}
.recent-toggle {
  display: flex;
  background: #f2f4f6;
  border-radius: 24rpx;
  padding: 4rpx;
}
.toggle-item {
  font-size: 22rpx;
  padding: 8rpx 22rpx;
  border-radius: 20rpx;
  color: #666;
  line-height: 1.4;
}
.toggle-active {
  background: #fff;
  color: #1677ff;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(22, 119, 255, 0.15);
}
.recent-tabs {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.recent-tab {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #5b6573;
  background: #f2f4f6;
  border-radius: 28rpx;
  line-height: 1.4;
}
.recent-tab-active {
  background: #1677ff;
  color: #fff;
  font-weight: 600;
}
.recent-list {
  margin-top: 8rpx;
}
.record-item {
  position: relative;
  display: flex;
  align-items: center;
  padding: 24rpx 56rpx 24rpx 0;
  border-bottom: 2rpx solid #f2f4f6;
}
.record-item:last-child {
  border-bottom: none;
}
.record-main {
  flex: 1;
  min-width: 0;
}
.record-fish {
  display: flex;
  align-items: baseline;
}
.record-fish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.3;
}
.record-fish-count {
  margin-left: 10rpx;
  font-size: 26rpx;
  color: #1677ff;
  font-weight: 600;
}
.record-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8c8c8c;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.record-dot {
  margin: 0 6rpx;
  color: #c9cdd4;
}
.record-point {
  color: #5b6573;
}
.record-tag {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-left: 16rpx;
  line-height: 1.4;
}
.tag-released {
  background: #e6f4ff;
  color: #1677ff;
}
.tag-kept {
  background: #fff7e6;
  color: #fa8c16;
}
.record-del {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #f2f4f6;
  color: #c9cdd4;
  border-radius: 50%;
  font-size: 28rpx;
}
.record-del:active {
  background: #ffe7e3;
  color: #e64340;
}
.record-empty {
  text-align: center;
  padding: 64rpx 0 32rpx;
}
.empty-fish {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.empty-fish-glyph {
  position: relative;
  width: 110rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-text {
  font-size: 26rpx;
  color: #8c8c8c;
  line-height: 1.5;
}
.empty-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 36rpx;
  background: #1677ff;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 32rpx;
}
.empty-btn:active {
  opacity: 0.85;
}
.record-loading,
.record-end {
  text-align: center;
  padding: 20rpx 0;
  font-size: 22rpx;
  color: #9aa3af;
  line-height: 1.5;
}

/* 日历视图骨架 */
.recent-calendar {
  padding: 16rpx 0 8rpx;
}
.cal-row {
  display: flex;
  font-size: 22rpx;
  color: #8c8c8c;
  text-align: center;
  padding: 8rpx 0;
  border-bottom: 2rpx solid #f2f4f6;
}
.cal-week {
  flex: 1;
}
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}
.cal-cell {
  width: calc(100% / 7);
  text-align: center;
  padding: 16rpx 0;
  box-sizing: border-box;
  position: relative;
}
.cal-day {
  font-size: 24rpx;
  color: #1f2329;
  line-height: 1.4;
}
.cal-mark {
  position: absolute;
  bottom: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #1677ff;
  color: #fff;
  border-radius: 20rpx;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  line-height: 1.3;
}
.cal-empty {
  visibility: hidden;
}
.cal-empty-tip {
  text-align: center;
  font-size: 24rpx;
  color: #9aa3af;
  padding: 32rpx 0;
}

/* ---- 全局空 ---- */
.page-empty {
  text-align: center;
  padding: 96rpx 0 64rpx;
}
.page-empty-text {
  font-size: 28rpx;
  color: #5b6573;
  line-height: 1.4;
}
.page-empty-btn {
  display: inline-block;
  margin-top: 28rpx;
  padding: 18rpx 56rpx;
  background: linear-gradient(135deg, #4096ff, #1677ff);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(22, 119, 255, 0.3);
}

/* ---- 弹层（快速录鱼）---- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}
.panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s ease;
}
.panel-show {
  transform: translateY(0);
}
.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
}
.panel-close {
  font-size: 44rpx;
  color: #9aa3af;
  padding: 0 8rpx;
  line-height: 1;
}
.panel-body {
  padding: 8rpx 0 24rpx;
}
.quick-fish {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 32rpx;
}
.quick-fish-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.quick-fish-name {
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}
.quick-count-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #f5f7fa;
  border-radius: 20rpx;
}
.quick-count-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}
.quick-count-control {
  display: flex;
  align-items: center;
}
.qc-btn {
  width: 64rpx;
  height: 64rpx;
  background: #fff;
  color: #1677ff;
  font-size: 36rpx;
  font-weight: 700;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}
.qc-btn:active {
  opacity: 0.85;
}
.qc-num {
  width: 100rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
}
.quick-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #8c8c8c;
  line-height: 1.5;
}
.panel-footer {
  margin-top: 16rpx;
}
.panel-btn {
  background: linear-gradient(135deg, #4096ff, #1677ff);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  height: 92rpx;
  line-height: 92rpx;
  box-shadow: 0 8rpx 20rpx rgba(22, 119, 255, 0.3);
}
.panel-btn::after {
  border: none;
}
.btn-hover {
  opacity: 0.9;
}
