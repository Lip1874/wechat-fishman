page{
  margin: 0;
  padding: 0;
  background: #f5f7fa;
}
.page{
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 顶部头部 */
.header{
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  background: linear-gradient(180deg, #e6f4ff 0%, #f5f7fa 100%);
  padding: 48rpx 32rpx 52rpx;
  border-radius: 0 0 44rpx 44rpx;
  overflow: hidden;
}
.header-left{
  position: relative;
  z-index: 1;
}
.header-title-row{
  display: flex;
  align-items: center;
}
.header-icon{
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #4096ff 0%, #1677ff 100%);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 18rpx;
  box-shadow: 0 6rpx 16rpx rgba(22, 119, 255, 0.3);
}
.header-title{
  color: #1f2329;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}
.header-sub{
  color: #666;
  font-size: 24rpx;
  margin-top: 12rpx;
  margin-left: 82rpx;
}
.header-btns{
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  display: flex;
  gap: 14rpx;
}
.map-btn{
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  background: rgba(22, 119, 255, 0.08);
  border: 2rpx solid rgba(22, 119, 255, 0.35);
  color: #1677ff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 16rpx 28rpx;
  border-radius: 44rpx;
  box-shadow: none;
}
.map-btn-hover{
  opacity: 0.85;
  transform: scale(0.97);
}

/* 模式/团队切换器 */
.mode-bar{
  position: relative;
  z-index: 6;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin: -40rpx 24rpx 0;
  background: #fff;
  border-radius: 32rpx;
  padding: 12rpx 12rpx 12rpx 20rpx;
  box-shadow: 0 14rpx 36rpx rgba(0, 0, 0, 0.08);
}
.mode-scroll{
  flex: 1;
  white-space: nowrap;
}
.mode-group{
  display: inline-flex;
  gap: 12rpx;
}
.mode-item{
  flex-shrink: 0;
  font-size: 26rpx;
  color: #666;
  background: #f5f6f8;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  border: 2rpx solid transparent;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mode-active{
  color: #fff;
  background: linear-gradient(90deg, #1677ff 0%, #4096ff 100%);
  border-color: transparent;
  font-weight: 600;
  box-shadow: 0 6rpx 14rpx rgba(22, 119, 255, 0.28);
}
.mode-manage{
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #1677ff;
  background: rgba(22, 119, 255, 0.06);
  border: 2rpx solid rgba(22, 119, 255, 0.3);
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
}
/* 管理按钮：团队模式高亮态 */
.mode-manage-active{
  color: #fff;
  background: linear-gradient(90deg, #1677ff 0%, #4096ff 100%);
  border-color: transparent;
  font-weight: 600;
  box-shadow: 0 6rpx 14rpx rgba(22, 119, 255, 0.28);
}

/* 搜索框 */
.search-bar{
  position: relative;
  z-index: 5;
  flex-shrink: 0;
  margin: 20rpx 24rpx 0;
}
.search-box{
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 44rpx;
  padding: 8rpx 10rpx 8rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}
.search-icon{
  flex-shrink: 0;
  font-size: 28rpx;
  margin-right: 12rpx;
}
.search-input{
  flex: 1;
  font-size: 28rpx;
  color: #222;
  height: 64rpx;
  line-height: 64rpx;
  min-width: 0;
}
.search-placeholder{
  color: #b0b4bb;
}
.search-clear{
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #eef0f2;
  color: #999;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
}
.search-btn{
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(90deg, #1677ff 0%, #4096ff 100%);
  padding: 14rpx 30rpx;
  border-radius: 36rpx;
}

/* 筛选面板 */
.filter-panel{
  position: relative;
  z-index: 5;
  flex-shrink: 0;
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx 24rpx 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
}
.fee-row{
  display: flex;
  align-items: center;
}
.fee-scroll{
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}
.fee-group{
  display: inline-flex;
  gap: 14rpx;
  padding: 2rpx 0;
}
.fee-tab{
  flex-shrink: 0;
  font-size: 26rpx;
  color: #666;
  background: #f5f6f8;
  padding: 12rpx 28rpx;
  border-radius: 36rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.fee-tab-active{
  color: #1677ff;
  background: rgba(22, 119, 255, 0.08);
  border-color: #1677ff;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(22, 119, 255, 0.12);
}
/* 更多筛选入口 */
.more-btn{
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f6f8;
  border: 2rpx solid #e5e8ec;
  padding: 10rpx 20rpx;
  border-radius: 36rpx;
  transition: all 0.2s;
}
.more-btn-on{
  color: #1677ff;
  background: rgba(22, 119, 255, 0.08);
  border-color: rgba(22, 119, 255, 0.45);
  font-weight: 600;
}
.more-text{
  line-height: 1;
}
.more-badge{
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 30rpx;
  height: 30rpx;
  margin-left: 8rpx;
  padding: 0 6rpx;
  border-radius: 16rpx;
  background: #1677ff;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  box-sizing: border-box;
}
.more-arrow{
  margin-left: 6rpx;
  font-size: 20rpx;
  color: #b0b4bb;
  line-height: 1;
}
/* 已选筛选标签 + 一键清空 */
.filter-tags{
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed #eef0f3;
}
.ft-tag{
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #1677ff;
  background: #e6f4ff;
  border: 2rpx solid rgba(22, 119, 255, 0.25);
  border-radius: 24rpx;
  padding: 6rpx 14rpx 6rpx 18rpx;
  max-width: 260rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ft-x{
  flex-shrink: 0;
  margin-left: 8rpx;
  color: #6ca6ff;
  font-size: 22rpx;
}
.ft-clear{
  flex-shrink: 0;
  font-size: 22rpx;
  color: #e64340;
  background: rgba(230, 67, 64, 0.08);
  border: 2rpx solid rgba(230, 67, 64, 0.3);
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
}

/* 列表：随页面整体滚动，不再被固定高度/天气卡片挤压 */
.list-scroll{
  width: 100%;
  box-sizing: border-box;
}
.list-inner{
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
}

/* 左滑删除容器 */
.swipe-wrap{
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
  margin-bottom: 18rpx;
}
.swipe-del{
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 160rpx;
  background: #e64340;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 24rpx 24rpx 0;
}
/* 列表卡片（内容层） */
.swipe-item{
  position: relative;
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-radius: 24rpx;
  padding: 22rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.25s ease;
  transform: translateX(0);
}
.swipe-item.swipe-no-anim{
  transition: none;
}
/* 批量模式：勾选框 + 选中高亮 */
.check-box{
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  border: 3rpx solid #c9cdd4;
  box-sizing: border-box;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  transition: all 0.15s;
}
.check-box-on{
  background: #1677ff;
  border-color: #1677ff;
}
.batch-item-on{
  background: #f0f7ff;
}
.item-hover{
  transform: scale(0.98);
  opacity: 0.92;
}
.cover-wrap{
  flex-shrink: 0;
  width: 168rpx;
  height: 168rpx;
  border-radius: 18rpx;
  overflow: hidden;
  margin-right: 22rpx;
  background: #eef0f2;
}
.cover{
  width: 100%;
  height: 100%;
}
.cover-placeholder{
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}
.item-info{
  flex: 1;
  overflow: hidden;
}
.item-head{
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.title{
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  flex: 1;
  margin-right: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.dist{
  flex-shrink: 0;
  font-size: 22rpx;
  color: #1677ff;
  background: rgba(22, 119, 255, 0.07);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
/* 距离 > 50km：置灰弱化 */
.dist-far{
  color: #b0b4bb;
  background: rgba(0, 0, 0, 0.04);
}
/* 近期有人上鱼标识 */
.recent-badge{
  flex-shrink: 0;
  margin-right: 10rpx;
  font-size: 20rpx;
  color: #0a7a46;
  background: rgba(10, 122, 70, 0.1);
  border: 2rpx solid rgba(10, 122, 70, 0.25);
  padding: 2rpx 12rpx;
  border-radius: 18rpx;
  font-weight: 600;
}
/* 作废钓点快捷操作：恢复 / 删除 */
.invalid-actions{
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}
.ia-btn{
  flex-shrink: 0;
  font-size: 22rpx;
  color: #5b6472;
  background: #f2f3f5;
  border: 2rpx solid #e2e5ea;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}
.ia-del{
  color: #e64340;
  border-color: rgba(230, 67, 64, 0.35);
  background: rgba(230, 67, 64, 0.06);
}
/* 正常钓点归档快捷入口 */
.archive-entry{
  display: inline-block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #8a8f99;
  border: 2rpx solid #e5e8ec;
  background: #f8f9fb;
  padding: 4rpx 16rpx;
  border-radius: 18rpx;
}
.record-invalid{
  color: #c0c4cc;
}
.tags{
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}
.tag{
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
/* 收费类型着色 */
.fee-green{
  color: #0a7a46;
  background: rgba(10, 122, 70, 0.1);
}
.fee-orange{
  color: #d48806;
  background: rgba(212, 136, 6, 0.1);
}
.fee-blue{
  color: #1f6feb;
  background: rgba(31, 111, 235, 0.1);
}
.fee-red{
  color: #d4380d;
  background: rgba(212, 56, 13, 0.1);
}
.tag-gray{
  color: #666;
  background: #f2f3f5;
}
.fish-row{
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}
.fish-chip{
  font-size: 22rpx;
  color: #1677ff;
  background: #e6f4ff;
  border: 1rpx solid rgba(22, 119, 255, 0.2);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}
.fish-more{
  font-size: 22rpx;
  color: #b0b4bb;
}
/* 团队钓点录入人 */
.record{
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #999;
}
.arrow{
  flex-shrink: 0;
  color: #d0d3d8;
  font-size: 44rpx;
  line-height: 168rpx;
  margin-left: 8rpx;
}

/* 空状态 */
.empty{
  padding: 100rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-icon{
  font-size: 88rpx;
  margin-bottom: 20rpx;
}
.empty-text{
  font-size: 30rpx;
  color: #666;
  font-weight: 600;
}
.empty-sub{
  font-size: 24rpx;
  color: #b0b4bb;
  margin-top: 8rpx;
}
.empty-btn{
  margin-top: 28rpx;
  padding: 14rpx 44rpx;
  background: #1677ff;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 16rpx rgba(22, 119, 255, 0.28);
}

/* 批量操作栏 */
.batch-bar{
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  z-index: 1000;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 48rpx;
  padding: 18rpx 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.14);
}
.batch-all{
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1677ff;
  padding: 8rpx 16rpx;
}
.batch-info{
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}
.batch-del{
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: #e64340;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
}
.batch-del-dis{
  opacity: 0.5;
}

/* 悬浮添加按钮（呼吸微动效） */
.add-btn{
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #1677ff 0%, #4096ff 100%);
  box-shadow: 0 10rpx 28rpx rgba(22, 119, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  animation: add-pulse 2.4s ease-in-out infinite;
}
.add-btn-hover{
  transform: scale(0.92);
  opacity: 0.9;
  animation: none;
}
.plus{
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}
/* 微动效：光晕呼吸 + 轻微缩放 */
@keyframes add-pulse{
  0%, 100%{
    box-shadow: 0 10rpx 28rpx rgba(22, 119, 255, 0.4);
    transform: scale(1);
  }
  50%{
    box-shadow: 0 10rpx 40rpx rgba(22, 119, 255, 0.65), 0 0 0 12rpx rgba(22, 119, 255, 0.08);
    transform: scale(1.06);
  }
}

/* 当前位置实况天气卡片 */
.weather-card{
  flex-shrink: 0;
  position: relative;
  z-index: 4;
  margin: 20rpx 24rpx 0;
  background: linear-gradient(135deg, #f0f7ff 0%, #ffffff 60%);
  border: 2rpx solid rgba(22, 119, 255, 0.12);
  border-radius: 28rpx;
  padding: 22rpx 26rpx;
  box-shadow: 0 12rpx 32rpx rgba(20, 90, 200, 0.08);
  box-sizing: border-box;
}

/* ---- 骨架 loading ---- */
.weather-skeleton{
  padding: 6rpx 0;
}
.skel-block{
  background: linear-gradient(90deg, #eef0f2 25%, #f7f8fa 50%, #eef0f2 75%);
  background-size: 400% 100%;
  animation: skel-shine 1.2s ease infinite;
  border-radius: 12rpx;
}
@keyframes skel-shine{
  0%{ background-position: 100% 0; }
  100%{ background-position: 0 0; }
}
.skel-warn{
  width: 60%;
  height: 28rpx;
  margin-bottom: 20rpx;
}
.skel-row{
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.skel-icon{
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  margin-right: 20rpx;
}
.skel-col{
  flex: 1;
}
.skel-temp{
  width: 45%;
  height: 52rpx;
  margin-bottom: 12rpx;
}
.skel-text{
  width: 70%;
  height: 28rpx;
}
.skel-meta{
  flex: 1;
  height: 40rpx;
  margin-right: 14rpx;
}
.skel-meta:last-child{
  margin-right: 0;
}
.skel-hour-row{
  gap: 14rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #e8ecef;
}
.skel-hour{
  flex: 1;
  height: 120rpx;
  border-radius: 16rpx;
}

/* ---- 预警提示条 ---- */
.weather-warn{
  display: flex;
  align-items: center;
  background: #fff4e6;
  border: 2rpx solid #ffb647;
  border-radius: 16rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
}
.warn-icon{
  flex-shrink: 0;
  font-size: 30rpx;
  margin-right: 10rpx;
}
.warn-text{
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #b26a00;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.warn-more{
  flex-shrink: 0;
  font-size: 22rpx;
  color: #d48806;
  margin-left: 10rpx;
}

/* ---- 位置 + 刷新 ---- */
.weather-head{
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.weather-place{
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}
.weather-refresh,
.weather-fail-btn{
  flex-shrink: 0;
  font-size: 22rpx;
  color: #1677ff;
  background: rgba(22, 119, 255, 0.08);
  border: 2rpx solid rgba(22, 119, 255, 0.25);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}
.weather-btn-hover{
  opacity: 0.75;
}
/* 天气卡片折叠开关 */
.weather-toggle{
  flex-shrink: 0;
  font-size: 22rpx;
  color: #1677ff;
  background: rgba(22, 119, 255, 0.08);
  border: 2rpx solid rgba(22, 119, 255, 0.25);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  margin-left: 12rpx;
}
/* 折叠态一行摘要 */
.weather-collapsed{
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 8rpx 0 4rpx;
}
.weather-collapsed-icon{
  font-size: 44rpx;
  line-height: 1;
}
.weather-collapsed-temp{
  font-size: 44rpx;
  font-weight: 800;
  color: #222;
  line-height: 1;
}
.weather-collapsed-text{
  font-size: 24rpx;
  color: #555;
}
.weather-collapsed-meta{
  flex-shrink: 0;
  font-size: 20rpx;
  color: #8a8f99;
  background: #eef4ff;
  border-radius: 16rpx;
  padding: 4rpx 14rpx;
}

/* ---- 主区域 ---- */
.weather-main{
  display: flex;
  align-items: center;
}
.weather-icon{
  flex-shrink: 0;
  font-size: 84rpx;
  margin-right: 24rpx;
}
.weather-info{
  flex: 1;
  min-width: 0;
}
.weather-temp{
  font-size: 72rpx;
  font-weight: 800;
  color: #222;
  line-height: 1;
}
.weather-deg{
  font-size: 44rpx;
  font-weight: 700;
}
.weather-text{
  font-size: 24rpx;
  color: #666;
  margin-top: 10rpx;
}
.weather-feel{
  font-size: 22rpx;
  color: #8a8f99;
  margin-top: 6rpx;
}

/* ---- 一行气象指标 ---- */
.weather-meta{
  display: flex;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed #e8ecef;
}
.weather-meta-item{
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  text-align: center;
  padding: 0 4rpx;
}
.meta-icon{
  font-size: 30rpx;
  line-height: 1;
}
.meta-val{
  font-size: 20rpx;
  color: #555;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---- 潮汐 / 风向预留展示区 ---- */
.weather-tide{
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed #e8ecef;
}
.tide-cell{
  flex: 1;
  display: flex;
  align-items: center;
  background: #eef4ff;
  border: 2rpx solid rgba(22, 119, 255, 0.12);
  border-radius: 20rpx;
  padding: 14rpx 16rpx;
  box-sizing: border-box;
}
.tide-icon{
  flex-shrink: 0;
  font-size: 30rpx;
  margin-right: 10rpx;
}
.tide-label{
  flex-shrink: 0;
  font-size: 22rpx;
  color: #1677ff;
  font-weight: 600;
  margin-right: 10rpx;
}
.tide-val{
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #555;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
}
.tide-empty{
  background: #f8f9fb;
  border-color: #e8ecef;
}
.tide-empty .tide-label{
  color: #8a8f99;
}
.tide-empty .tide-val{
  color: #c0c4cc;
}

/* ---- 未来24小时逐时预报 ---- */
.weather-hourly{
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed #e8ecef;
}
.hourly-title{
  font-size: 22rpx;
  font-weight: 700;
  color: #1677ff;
  margin-bottom: 12rpx;
}
.hourly-scroll{
  width: 100%;
  white-space: nowrap;
}
.hourly-row{
  display: inline-flex;
  gap: 10rpx;
  padding-right: 8rpx;
}
.hourly-col{
  flex-shrink: 0;
  width: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: #f5f9ff;
  border: 2rpx solid rgba(22, 119, 255, 0.08);
  border-radius: 18rpx;
  padding: 14rpx 0 12rpx;
  box-sizing: border-box;
}
.h-time{
  font-size: 22rpx;
  font-weight: 600;
  color: #555;
  line-height: 1;
}
.h-icon{
  font-size: 36rpx;
  line-height: 1;
}
.h-temp{
  font-size: 30rpx;
  font-weight: 800;
  color: #222;
  line-height: 1;
}
.h-prob{
  font-size: 20rpx;
  line-height: 1;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}
/* 降雨概率颜色分级 */
.h-prob.prob-low{
  color: #9aa0a8;
  background: #eef0f2;
}
.h-prob.prob-mid{
  color: #1f6feb;
  background: #e8f0fe;
}
.h-prob.prob-high{
  color: #fff;
  background: #1a5fd0;
}
.h-prob:not(.prob-low):not(.prob-mid):not(.prob-high){
  color: #9aa0a8;
  background: #eef0f2;
}

/* ---- 钓鱼指数 + 紫外线 ---- */
.weather-idx-row{
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}
.weather-idx-card{
  flex: 1;
  min-width: 0;
  background: #eef4ff;
  border: 2rpx solid rgba(22, 119, 255, 0.12);
  border-radius: 20rpx;
  padding: 16rpx;
  box-sizing: border-box;
}
.idx-title{
  font-size: 22rpx;
  font-weight: 700;
  color: #1677ff;
  margin-bottom: 8rpx;
}
.idx-level{
  font-size: 30rpx;
  font-weight: 800;
  color: #1677ff;
  line-height: 1.2;
}
.idx-num{
  font-size: 22rpx;
  font-weight: 600;
  color: #8a8f99;
  margin-left: 4rpx;
}
.idx-text{
  font-size: 20rpx;
  color: #5a7ba3;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ---- 失败/拒绝状态 ---- */
.weather-fail{
  font-size: 26rpx;
  color: #8a8f99;
  padding: 10rpx 0;
}
.weather-fail-btn{
  display: inline-block;
  margin-top: 14rpx;
}

/* ---- 钓点状态筛选（全部/正常/作废）---- */
.status-row{
  align-items: center;
  margin-top: 20rpx;
}
.status-label{
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
}
.status-group{
  flex: 1;
  display: flex;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 6rpx;
}
.status-tab{
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #666;
  padding: 12rpx 0;
  border-radius: 12rpx;
  transition: all 0.2s;
}
.status-tab-active{
  color: #1677ff;
  background: #fff;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(22, 119, 255, 0.15);
}
.status-hint{
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #b0b4bb;
}

/* 加载更多 / 到底提示 */
.load-more{
  text-align: center;
  font-size: 24rpx;
  color: #b0b4bb;
  padding: 24rpx 0 8rpx;
}

/* 首页加载失败 */
.load-error{
  padding: 90rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.load-error-icon{
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
.load-error-text{
  font-size: 26rpx;
  color: #666;
  text-align: center;
}
.load-error-btn{
  margin-top: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1677ff;
  background: rgba(22, 119, 255, 0.08);
  border: 2rpx solid rgba(22, 119, 255, 0.3);
  padding: 14rpx 48rpx;
  border-radius: 36rpx;
}

/* ---- 作废钓点置灰 + 整体降低透明度 ---- */
.item-invalid{
  background: #f7f7f7;
  opacity: 0.62;
}
.item-invalid .cover-wrap{
  background: #e4e6e9;
}
.item-invalid .cover-placeholder{
  filter: grayscale(1);
  opacity: 0.6;
}
.title-invalid{
  color: #a0a4ab;
  text-decoration: line-through;
}
.tag-invalid{
  color: #999;
  background: rgba(153, 153, 153, 0.14);
}

/* ---- 更多筛选弹窗（半屏底部弹出） ---- */
.filter-mask{
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1100;
}
.filter-sheet{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1101;
  background: #fff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-height: 76vh;
  display: flex;
  flex-direction: column;
  animation: sheet-up 0.25s ease-out;
}
@keyframes sheet-up{
  from{ transform: translateY(30%); opacity: 0.6; }
  to{ transform: translateY(0); opacity: 1; }
}
.sheet-head{
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f2f5;
}
.sheet-title{
  flex: 1;
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2329;
}
.sheet-clear{
  flex-shrink: 0;
  font-size: 24rpx;
  color: #e64340;
  background: rgba(230, 67, 64, 0.06);
  border: 2rpx solid rgba(230, 67, 64, 0.3);
  padding: 8rpx 22rpx;
  border-radius: 26rpx;
  margin-right: 16rpx;
}
.sheet-close{
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f2f3f5;
  color: #8a8f99;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet-body{
  flex: 1;
  min-height: 0;
  margin-top: 8rpx;
}
.sheet-group{
  margin-top: 26rpx;
}
.sheet-label{
  font-size: 26rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}
.chip-wrap{
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.chip{
  flex-shrink: 0;
  font-size: 24rpx;
  color: #666;
  background: #f5f6f8;
  border: 2rpx solid transparent;
  padding: 10rpx 26rpx;
  border-radius: 32rpx;
  transition: all 0.15s;
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.chip-on{
  color: #1677ff;
  background: rgba(22, 119, 255, 0.08);
  border-color: #1677ff;
  font-weight: 600;
}
.sheet-status{
  width: 100%;
}
.sheet-foot{
  flex-shrink: 0;
  margin-top: 24rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(90deg, #1677ff 0%, #4096ff 100%);
  padding: 20rpx 0;
  border-radius: 44rpx;
}
