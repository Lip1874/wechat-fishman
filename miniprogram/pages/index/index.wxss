page{
  margin: 0;
  padding: 0;
  background: #f5f6f8;
}
.page{
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

/* 顶部绿色头部 */
.header{
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  background: linear-gradient(135deg, #19c56f 0%, #0aa55e 42%, #00723a 100%);
  padding: 48rpx 32rpx 52rpx;
  border-radius: 0 0 44rpx 44rpx;
  overflow: hidden;
}
.header-deco{
  position: absolute;
  right: -90rpx;
  top: -90rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.09);
}
.header-deco2{
  position: absolute;
  right: 160rpx;
  bottom: -70rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
}
/* 漂浮气泡装饰 */
.bubble{
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  animation: float 6s ease-in-out infinite;
}
.b1{ width: 48rpx; height: 48rpx; right: 150rpx; top: 66rpx; }
.b2{ width: 28rpx; height: 28rpx; right: 220rpx; top: 116rpx; animation-delay: 2s; }
.b3{ width: 20rpx; height: 20rpx; right: 76rpx; top: 156rpx; animation-delay: 4s; }
@keyframes float{
  0%, 100%{ transform: translateY(0); }
  50%{ transform: translateY(-16rpx); }
}
/* 底部波浪装饰 */
.header-wave{
  position: absolute;
  left: -10%;
  width: 120%;
  bottom: -14rpx;
  height: 46rpx;
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  background: rgba(255, 255, 255, 0.12);
}
.header-wave2{
  position: absolute;
  left: -25%;
  width: 150%;
  bottom: -36rpx;
  height: 62rpx;
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  background: rgba(255, 255, 255, 0.06);
}
.header-left{
  position: relative;
  z-index: 1;
}
.header-title-row{
  display: flex;
  align-items: center;
}
.header-icon{
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 18rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 60, 30, 0.15);
}
.header-title{
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}
.header-sub{
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  margin-top: 12rpx;
  margin-left: 82rpx;
}
.header-btns{
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  display: flex;
  gap: 14rpx;
}
.map-btn{
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 16rpx 28rpx;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 60, 30, 0.18);
}
.map-btn-hover{
  opacity: 0.85;
  transform: scale(0.97);
}

/* 模式/团队切换器 */
.mode-bar{
  position: relative;
  z-index: 6;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin: -40rpx 24rpx 0;
  background: #fff;
  border-radius: 32rpx;
  padding: 12rpx 12rpx 12rpx 20rpx;
  box-shadow: 0 14rpx 36rpx rgba(0, 0, 0, 0.08);
}
.mode-scroll{
  flex: 1;
  white-space: nowrap;
}
.mode-group{
  display: inline-flex;
  gap: 12rpx;
}
.mode-item{
  flex-shrink: 0;
  font-size: 26rpx;
  color: #666;
  background: #f5f6f8;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  border: 2rpx solid transparent;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mode-active{
  color: #fff;
  background: linear-gradient(135deg, #0aa55e, #008844);
  border-color: transparent;
  font-weight: 600;
  box-shadow: 0 6rpx 14rpx rgba(0, 136, 68, 0.28);
}
.mode-manage{
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #008844;
  background: rgba(0, 136, 68, 0.06);
  border: 2rpx solid rgba(0, 136, 68, 0.3);
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
}

/* 筛选面板 */
.filter-panel{
  position: relative;
  z-index: 5;
  flex-shrink: 0;
  margin: 0 24rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx 24rpx 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
}
.fee-scroll{
  width: 100%;
  white-space: nowrap;
}
.fee-group{
  display: inline-flex;
  gap: 14rpx;
  padding: 2rpx 0;
}
.fee-tab{
  flex-shrink: 0;
  font-size: 26rpx;
  color: #666;
  background: #f5f6f8;
  padding: 12rpx 28rpx;
  border-radius: 36rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.fee-tab-active{
  color: #008844;
  background: rgba(0, 136, 68, 0.08);
  border-color: #008844;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 136, 68, 0.12);
}
.filter-row{
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.filter-picker{
  flex: 1;
}
.filter-select{
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
}
.filter-text{
  font-size: 26rpx;
  color: #222;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.filter-placeholder{
  color: #b0b4bb;
}
.filter-arrow{
  flex-shrink: 0;
  color: #b0b4bb;
  font-size: 26rpx;
  line-height: 1;
  margin-left: 10rpx;
}

/* 列表 */
.list-scroll{
  flex: 1;
  height: 0;
}
.list-inner{
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
}

/* 左滑删除容器 */
.swipe-wrap{
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
  margin-bottom: 18rpx;
}
.swipe-del{
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 160rpx;
  background: #e64340;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 24rpx 24rpx 0;
}
/* 列表卡片（内容层） */
.swipe-item{
  position: relative;
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-radius: 24rpx;
  padding: 22rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.25s ease;
  transform: translateX(0);
}
.swipe-item.swipe-no-anim{
  transition: none;
}
/* 批量模式：勾选框 + 选中高亮 */
.check-box{
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  border: 3rpx solid #c9cdd4;
  box-sizing: border-box;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  transition: all 0.15s;
}
.check-box-on{
  background: #008844;
  border-color: #008844;
}
.batch-item-on{
  background: #f0faf5;
}
.item-hover{
  transform: scale(0.98);
  opacity: 0.92;
}
.cover-wrap{
  flex-shrink: 0;
  width: 168rpx;
  height: 168rpx;
  border-radius: 18rpx;
  overflow: hidden;
  margin-right: 22rpx;
  background: #eef0f2;
}
.cover{
  width: 100%;
  height: 100%;
}
.cover-placeholder{
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}
.item-info{
  flex: 1;
  overflow: hidden;
}
.item-head{
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.title{
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  flex: 1;
  margin-right: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.dist{
  flex-shrink: 0;
  font-size: 22rpx;
  color: #008844;
  background: rgba(0, 136, 68, 0.07);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
.tags{
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}
.tag{
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
/* 收费类型着色 */
.fee-green{
  color: #0a7a46;
  background: rgba(10, 122, 70, 0.1);
}
.fee-orange{
  color: #d48806;
  background: rgba(212, 136, 6, 0.1);
}
.fee-blue{
  color: #1f6feb;
  background: rgba(31, 111, 235, 0.1);
}
.fee-red{
  color: #d4380d;
  background: rgba(212, 56, 13, 0.1);
}
.tag-gray{
  color: #666;
  background: #f2f3f5;
}
.fish-row{
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}
.fish-chip{
  font-size: 22rpx;
  color: #0a7a46;
  background: #eef7f1;
  border: 1rpx solid rgba(0, 136, 68, 0.2);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}
.fish-more{
  font-size: 22rpx;
  color: #b0b4bb;
}
/* 团队钓点录入人 */
.record{
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #999;
}
.arrow{
  flex-shrink: 0;
  color: #d0d3d8;
  font-size: 44rpx;
  line-height: 168rpx;
  margin-left: 8rpx;
}

/* 空状态 */
.empty{
  padding: 100rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-icon{
  font-size: 88rpx;
  margin-bottom: 20rpx;
}
.empty-text{
  font-size: 30rpx;
  color: #666;
  font-weight: 600;
}
.empty-sub{
  font-size: 24rpx;
  color: #b0b4bb;
  margin-top: 8rpx;
}

/* 批量操作栏 */
.batch-bar{
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 36rpx;
  z-index: 1000;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 48rpx;
  padding: 18rpx 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.14);
}
.batch-all{
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #008844;
  padding: 8rpx 16rpx;
}
.batch-info{
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}
.batch-del{
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: #e64340;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
}
.batch-del-dis{
  opacity: 0.5;
}

/* 悬浮添加按钮 */
.add-btn{
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0aa55e, #008844);
  box-shadow: 0 10rpx 28rpx rgba(0, 136, 68, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.add-btn-hover{
  transform: scale(0.92);
  opacity: 0.9;
}
.plus{
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}
