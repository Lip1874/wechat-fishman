page {
  background: #f5f7fa;
}
/* 图片轮播 */
.gallery-wrap {
  position: relative;
  width: 100%;
}
.gallery {
  width: 100%;
  height: 420rpx;
}
.gallery-img {
  width: 100%;
  height: 420rpx;
}
.gallery-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef0f2;
  color: #b0b4bb;
  font-size: 28rpx;
}
/* 左右箭头 */
.arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.35);
  color: #fff;
  font-size: 44rpx;
  text-align: center;
  line-height: 60rpx;
  z-index: 10;
}
.arrow-left {
  left: 20rpx;
}
.arrow-right {
  right: 20rpx;
}
/* 图片序号 */
.gallery-counter {
  position: absolute;
  right: 24rpx;
  bottom: 64rpx;
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
}
.content {
  padding: 24rpx;
  margin-bottom: 140rpx;
  box-sizing: border-box;
}
/* 标题卡片 */
.head {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.head-left {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}
.name {
  font-size: 38rpx;
  font-weight: 700;
  color: #222;
}
.record {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}
.tag {
  flex-shrink: 0;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-weight: 600;
}
/* 收费类型标签配色 */
.tag-green {
  background: rgba(0, 136, 68, 0.1);
  color: #008844;
}
.tag-orange {
  background: rgba(255, 140, 0, 0.14);
  color: #e67e00;
}
.tag-blue {
  background: rgba(24, 144, 255, 0.12);
  color: #1890ff;
}
.tag-red {
  background: rgba(230, 67, 64, 0.1);
  color: #e64340;
}
/* 信息卡片 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.row:last-child {
  border-bottom: none;
}
.row-label {
  font-size: 28rpx;
  color: #666;
}
.row-value {
  font-size: 28rpx;
  color: #222;
  font-weight: 600;
}
.dist-value {
  color: #1677ff;
}
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 20rpx;
}
/* 钓点实时天气：具体地址 */
.w-addr {
  font-size: 22rpx;
  color: #1677ff;
  margin-top: -8rpx;
  margin-bottom: 16rpx;
  line-height: 1.6;
}
/* 鱼种 */
.fish-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.chip {
  background: #eef4ff;
  color: #1677ff;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  border: 2rpx solid rgba(22, 119, 255, 0.15);
}
.remark {
  font-size: 28rpx;
  color: #444;
  line-height: 1.7;
}
/* 底部操作按钮 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.footer-row {
  display: flex;
  gap: 16rpx;
}
.edit-btn,
.move-btn {
  flex: 1;
  height: 92rpx;
  line-height: 88rpx;
  background: #fff;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
  padding: 0 16rpx;
}
.edit-btn {
  color: #1677ff;
  border: 2rpx solid #1677ff;
}
.move-btn {
  color: #e67e00;
  border: 2rpx solid #e67e00;
}
.edit-btn::after,
.move-btn::after {
  border: none;
}
.nav-btn {
  flex: 1.2;
  background: linear-gradient(90deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
}
.nav-btn::after {
  border: none;
}
.btn-hover {
  opacity: 0.85;
}
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  color: #b0b4bb;
  font-size: 28rpx;
}
/* 该钓点实时天气 */
.w-loading{
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #8a8f99;
  font-size: 26rpx;
  padding: 8rpx 0;
}
.w-spinner{
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid rgba(22, 119, 255, 0.2);
  border-top-color: #1677ff;
  border-radius: 50%;
  animation: w-rotate 0.8s linear infinite;
}
@keyframes w-rotate{
  from{ transform: rotate(0deg); }
  to{ transform: rotate(360deg); }
}
.w-main{
  display: flex;
  align-items: center;
}
.w-icon{
  flex-shrink: 0;
  font-size: 64rpx;
  margin-right: 20rpx;
}
.w-info{
  flex: 1;
  min-width: 0;
}
.w-temp{
  font-size: 48rpx;
  font-weight: 800;
  color: #222;
  line-height: 1.1;
}
.w-text{
  font-size: 24rpx;
  color: #8a8f99;
  margin-top: 4rpx;
}
.w-refresh{
  flex-shrink: 0;
  font-size: 22rpx;
  color: #1677ff;
  background: rgba(22, 119, 255, 0.08);
  border: 2rpx solid rgba(22, 119, 255, 0.25);
  padding: 10rpx 22rpx;
  border-radius: 30rpx;
}
.w-btn-hover{
  opacity: 0.75;
}
.w-meta{
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}
.w-meta-item{
  font-size: 22rpx;
  color: #666;
  background: #f5f6f8;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}
.w-indices{
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #e8ecef;
}
.w-idx{
  font-size: 24rpx;
  color: #1677ff;
  background: #eef4ff;
  padding: 8rpx 18rpx;
  border-radius: 18rpx;
}
.w-fail{
  font-size: 26rpx;
  color: #8a8f99;
  padding: 8rpx 0;
}
.w-refresh{
  margin-top: 12rpx;
}
/* 已作废提示条 */
.invalid-banner{
  background: #fff4f4;
  border: 2rpx solid #f0b9b9;
  color: #c0392b;
  font-size: 26rpx;
  padding: 18rpx 28rpx;
  text-align: center;
}
/* 已作废标签 */
.tag-invalid{
  background: rgba(153, 153, 153, 0.14);
  color: #999;
  border: 2rpx solid rgba(153, 153, 153, 0.35);
  margin-right: 12rpx;
}
/* 保存时天气记录 */
.w-snap{
  background: #f0f7ff;
  border: 2rpx solid rgba(22, 119, 255, 0.12);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.w-snap-main{
  display: flex;
  align-items: center;
}
.w-snap-emoji{
  flex-shrink: 0;
  font-size: 56rpx;
  margin-right: 20rpx;
}
.w-snap-info{
  flex: 1;
  min-width: 0;
}
.w-snap-temp{
  font-size: 36rpx;
  font-weight: 800;
  color: #222;
  line-height: 1.2;
}
.w-snap-text{
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
}
.w-snap-place{
  font-size: 22rpx;
  color: #1677ff;
  margin-top: 4rpx;
}
.w-snap-time{
  font-size: 22rpx;
  color: #8a8f99;
  margin-top: 12rpx;
}
/* ==================== 编辑模式 ==================== */
/* 编辑状态提示条 */
.edit-banner{
  background: #eef4ff;
  border-bottom: 2rpx solid rgba(22, 119, 255, 0.15);
  color: #1677ff;
  font-size: 26rpx;
  padding: 18rpx 28rpx;
  text-align: center;
}
/* 表单卡片 */
.form-card{
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.form-item{
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
  display: flex;
  flex-direction: column;
}
.form-item:last-child{
  border-bottom: none;
}
.label{
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 18rpx;
}
.label-icon{
  margin-right: 12rpx;
  font-size: 30rpx;
}
.required{
  color: #e64340;
  margin-left: 8rpx;
}
.count{
  margin-left: auto;
  font-size: 24rpx;
  color: #b0b4bb;
  font-weight: 400;
}
/* 输入框 */
.input{
  display: block;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 32rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
}
.textarea{
  display: block;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  width: 100%;
  box-sizing: border-box;
  height: 260rpx;
  font-size: 32rpx;
}
.placeholder{
  color: #b0b4bb;
}
/* 下拉选择 */
.picker-full{
  display: block;
  width: 100%;
}
.select{
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  min-height: 88rpx;
  box-sizing: border-box;
}
.select-active{
  background: rgba(22, 119, 255, 0.06);
  border: 2rpx solid rgba(22, 119, 255, 0.3);
  box-sizing: border-box;
}
.select-value{
  font-size: 32rpx;
  color: #333;
}
.select-value.placeholder{
  color: #b0b4bb;
}
.select-arrow{
  flex-shrink: 0;
  color: #b0b4bb;
  font-size: 44rpx;
  line-height: 1;
  margin-left: 16rpx;
}
/* 编辑表单内的标签按钮（作用域限定，避免影响只读态 .tag 配色） */
.tag-group{
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.form-card .tag{
  background: #f5f6f8;
  color: #666;
  border: 2rpx solid transparent;
  padding: 14rpx 30rpx;
}
.form-card .tag-active{
  background: rgba(22, 119, 255, 0.08);
  color: #1677ff;
  border-color: #1677ff;
  font-weight: 600;
}
/* 编辑态已选鱼种 chips */
.fish-chip{
  background: rgba(22, 119, 255, 0.1);
  color: #1677ff;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}
.fish-chip-del{
  margin-left: 8rpx;
  font-size: 28rpx;
  color: #666;
}
/* 鱼种多选面板 */
.mask{
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}
.panel{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s ease;
}
.panel-show{
  transform: translateY(0);
}
.panel-header{
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.panel-title{
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}
.panel-close{
  font-size: 44rpx;
  color: #999;
  padding: 0 8rpx;
}
.panel-body{
  max-height: 520rpx;
}
.fish-option{
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid #f2f3f5;
  font-size: 30rpx;
  color: #333;
}
.fish-option-active{
  color: #1677ff;
  font-weight: 600;
}
.check{
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #c9cdd4;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 26rpx;
  color: #fff;
  box-sizing: border-box;
}
.fish-option-active .check{
  background: #1677ff;
  border-color: #1677ff;
}
.panel-footer{
  margin-top: 24rpx;
}
.panel-btn{
  background: linear-gradient(90deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
}
.panel-btn::after{
  border: none;
}
/* 地图选点 */
.map-picker{
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 24rpx;
}
.map-picker-title{
  font-size: 28rpx;
  color: #666;
}
.map-preview-wrap{
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid rgba(22, 119, 255, 0.3);
  box-sizing: border-box;
}
.map-preview{
  width: 100%;
  height: 300rpx;
  display: block;
}
.map-preview-footer{
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx;
  background: rgba(22, 119, 255, 0.06);
}
.map-preview-btn{
  font-size: 26rpx;
  color: #fff;
  background: #1677ff;
  border-radius: 30rpx;
  padding: 8rpx 28rpx;
}
/* 自定义地图选点弹层 */
.map-mask{
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}
.map-picker-panel{
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  flex-direction: column;
}
.map-picker-header{
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.map-picker-close{
  font-size: 44rpx;
  color: #999;
  padding: 0 8rpx;
}
.map-search{
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f2f3f5;
}
.map-search-input{
  flex: 1;
  background: #f5f6f8;
  border-radius: 40rpx;
  height: 72rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}
.map-search-btn{
  flex-shrink: 0;
  margin-left: 16rpx;
  background: #1677ff;
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 30rpx;
  border-radius: 40rpx;
}
.map-search-list{
  max-height: 360rpx;
  background: #fff;
  border-bottom: 1rpx solid #f2f3f5;
  box-sizing: border-box;
}
.map-search-item{
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.map-search-item:active{
  background: #f5f6f8;
}
.map-search-title{
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}
.map-search-addr{
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.map-full{
  flex: 1;
  width: 100%;
}
.map-picker-footer{
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
}
.map-picker-confirm{
  background: linear-gradient(90deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
}
.map-picker-confirm::after{
  border: none;
}
/* 实拍图片 */
.img-grid{
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.img-item{
  position: relative;
  width: 196rpx;
  height: 196rpx;
}
.preview-img{
  width: 196rpx;
  height: 196rpx;
  border-radius: 16rpx;
}
.img-del{
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 28rpx;
}
.add-img{
  width: 196rpx;
  height: 196rpx;
  border: 2rpx dashed #c9cdd4;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #b0b4bb;
  background: #fafbfc;
}
.add-plus{
  font-size: 56rpx;
  line-height: 1;
}
.add-text{
  font-size: 24rpx;
  margin-top: 10rpx;
}
.tip{
  font-size: 24rpx;
  color: #b0b4bb;
  text-align: center;
  margin: 8rpx 0 24rpx;
}
/* 编辑态底部按钮：取消 / 保存修改 */
.cancel-btn,
.save-btn{
  flex: 1;
  height: 92rpx;
  line-height: 88rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-sizing: border-box;
}
.cancel-btn{
  background: #fff;
  color: #666;
  border: 2rpx solid #d9dce1;
}
.save-btn{
  background: linear-gradient(90deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
}
.cancel-btn::after,
.save-btn::after{
  border: none;
}
