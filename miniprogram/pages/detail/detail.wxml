<view wx:if="{{info}}">
  <!-- 实拍图片轮播 -->
  <view wx:if="{{info.images && info.images.length}}" class="gallery-wrap">
    <swiper class="gallery" current="{{current}}" bindchange="onSwiperChange" indicator-dots indicator-color="rgba(255,255,255,0.6)" indicator-active-color="#fff" circular>
      <swiper-item wx:for="{{info.images}}" wx:key="*this">
        <image src="{{item}}" class="gallery-img" mode="aspectFill" bindtap="previewImg" data-src="{{item}}"/>
      </swiper-item>
    </swiper>
    <view class="gallery-counter" wx:if="{{info.images.length > 1}}">{{current + 1}}/{{info.images.length}}</view>
    <view class="arrow arrow-left" wx:if="{{info.images.length > 1}}" catchtap="prevImg">‹</view>
    <view class="arrow arrow-right" wx:if="{{info.images.length > 1}}" catchtap="nextImg">›</view>
  </view>
  <view wx:else class="gallery gallery-empty">暂无实拍图片</view>

  <view class="content">
    <!-- 标题 -->
    <view class="head">
      <view class="head-left">
        <view class="name">{{info.name}}</view>
        <view class="record" wx:if="{{info.creatorShort}}">录入人：{{info.creatorShort}}</view>
      </view>
      <view class="tag {{info.tagClass}}">{{info.feeType}}</view>
    </view>

    <!-- 基础信息 -->
    <view class="card">
      <view class="row" wx:if="{{distance}}">
        <text class="row-label">📍 距离我的位置</text>
        <text class="row-value dist-value">{{distance}}</text>
      </view>
      <view class="row">
        <text class="row-label">🌊 水域类型</text>
        <text class="row-value">{{info.waterType || '未填写'}}</text>
      </view>
      <view class="row">
        <text class="row-label">📏 水深</text>
        <text class="row-value">{{info.depth ? info.depth + 'm' : '未填写'}}</text>
      </view>
      <view class="row">
        <text class="row-label">🅿️ 停车情况</text>
        <text class="row-value">{{info.park || '未填写'}}</text>
      </view>
    </view>

    <!-- 该钓点实时天气（使用钓点自身坐标） -->
    <view class="card">
      <view class="card-title">🌤 该钓点实时天气</view>
      <block wx:if="{{weatherStatus === 'loading'}}">
        <view class="w-loading">
          <view class="w-spinner"></view>
          <text>正在获取该钓点天气...</text>
        </view>
      </block>
      <block wx:elif="{{weatherStatus === 'ok' && weather}}">
        <view class="w-main">
          <view class="w-icon">{{weather.emoji}}</view>
          <view class="w-info">
            <view class="w-temp">{{weather.temp}}°</view>
            <view class="w-text">{{weather.text}} · 体感 {{weather.feelsLike}}°</view>
          </view>
          <view class="w-refresh" bindtap="onRefreshWeather" hover-class="w-btn-hover">🔄 刷新</view>
        </view>
        <view class="w-meta">
          <view class="w-meta-item">{{weather.windDir}} {{weather.windScale}}级</view>
          <view class="w-meta-item">💧 湿度 {{weather.humidity}}%</view>
          <view class="w-meta-item">🌧 降水 {{weather.precip}}mm</view>
        </view>
        <view class="w-indices">
          <view class="w-idx">🎣 钓鱼指数：{{weather.fishing ? weather.fishing.text : '--'}}</view>
          <view class="w-idx">☀️ 紫外线：{{weather.uv ? weather.uv.text : '--'}}</view>
        </view>
      </block>
      <block wx:elif="{{weatherStatus === 'nopos'}}">
        <view class="w-fail">该钓点未保存位置信息，无法获取天气</view>
      </block>
      <block wx:else>
        <view class="w-fail">🌥 {{weatherError || '该钓点天气暂时不可用，可稍后刷新'}}</view>
        <view class="w-refresh" bindtap="onRefreshWeather" hover-class="w-btn-hover">🔄 刷新</view>
      </block>
    </view>

    <!-- 目标鱼种 -->
    <view class="card" wx:if="{{info.fish && info.fish.length}}">
      <view class="card-title">🎣 目标鱼种</view>
      <view class="fish-chips">
        <view class="chip" wx:for="{{info.fish}}" wx:key="*this">{{item}}</view>
      </view>
    </view>

    <!-- 钓点备注 -->
    <view class="card" wx:if="{{info.remark}}">
      <view class="card-title">📝 钓点备注</view>
      <view class="remark">{{info.remark}}</view>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view class="footer">
    <view class="footer-row">
      <button wx:if="{{info.canEdit}}" bindtap="editPoint" class="edit-btn" hover-class="btn-hover">✏️ 编辑</button>
      <button wx:if="{{info.canEdit && !info.teamId}}" bindtap="moveToTeam" class="move-btn" hover-class="btn-hover">📦 移到团队</button>
      <button bindtap="openNav" class="nav-btn" hover-class="btn-hover">📍 立即导航前往</button>
    </view>
  </view>
</view>
<view wx:else class="loading">加载中...</view>
